# Builds AniCal from this source checkout:  cd packaging && makepkg -si
pkgname=anical
pkgver=0.1.0
pkgrel=3
pkgdesc="Anime library and airing calendar, with ani-cli playback"
arch=('any')
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita>=1:1.8' 'libsecret')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('ani-cli: play episodes'
            'mpv: track how far you watched')
source=()

_appid=io.github.dhopson.AniCal
_root="$(realpath "$startdir/..")"

build() {
  python -m build --wheel --no-isolation --outdir "$srcdir/dist" "$_root"
}

package() {
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_root/packaging/$_appid.desktop" "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "$_root/packaging/$_appid.metainfo.xml" "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
  install -Dm644 "$_root/anical/data/icons/hicolor/scalable/apps/$_appid.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_appid.svg"
  install -Dm644 "$_root/anical/data/icons/hicolor/symbolic/apps/$_appid-symbolic.svg" \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/$_appid-symbolic.svg"
}
